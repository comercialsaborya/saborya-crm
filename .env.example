# ---------------------------------------------------------------
# Saborya CRM — variáveis de ambiente
# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API).
# ---------------------------------------------------------------

# URL do projeto (pública)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (publishable / anon). Segura no navegador: o RLS protege os dados.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Chave secreta (service role / secret). SOMENTE no servidor (Vercel → Environment Variables).
# Usada apenas para o gestor criar/bloquear usuários e para os scripts de dados demo.
# NUNCA use o prefixo NEXT_PUBLIC_ nesta variável.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# URL pública do app (links de recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
